# ==============================================================================
# Astrea SDA API - Environment Configuration Template
# Copy to .env and customize as needed: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Tailscale OSS Zero-Config Gateway ("Batteries Included")
# ------------------------------------------------------------------------------
# Generate a free reusable or ephemeral auth key at:
# https://login.tailscale.com/admin/settings/keys
# If left empty, Tailscale will generate an interactive browser login link on first boot.
TS_AUTHKEY=
TS_HOSTNAME=sda
TS_USERSPACE=true

# ------------------------------------------------------------------------------
# 🗄️ Database & Distributed Caching
# ------------------------------------------------------------------------------
# Local dev defaults (mapped port 5433 for dev, 5432 for host dev-hot and prod)
POSTGRES_URI=postgres://astrea:astreadbpass@127.0.0.1:5432/astrea_sda
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 🔑 Security & RS256 JWT Authentication
# ------------------------------------------------------------------------------
# Auto-generated by 'make keys' or './scripts/setup-keys.sh'
RSA_PRIVATE_KEY_FILE=.keys/rsa_private.pem
RSA_PUBLIC_KEY_FILE=.keys/rsa_public.pem

# ------------------------------------------------------------------------------
# ⚙️ Application Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
ENABLE_DISCOVERY_PIPELINE=true
RUST_LOG=info,astrea_sda_api=debug
