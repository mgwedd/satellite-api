{
  "openapi": "3.0.3",
  "info": {
    "title": "satellite-api",
    "description": "A high-performance Rust API for satellite tracking, SGP4 propagation, and visibility prediction",
    "contact": {
      "name": "Michael Wedd"
    },
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/astrodynamics/overhead": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Get Overhead Satellite",
        "description": "Computes the satellite closest to overhead (highest elevation) across all tracked satellites using parallel Rayon propagation.",
        "operationId": "getOverheadSatellite",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Observer latitude in decimal degrees (-90.0 to 90.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Observer longitude in decimal degrees (-180.0 to 180.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "alt",
            "in": "query",
            "description": "Observer altitude above sea level in meters",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          },
          {
            "name": "time",
            "in": "query",
            "description": "UTC timestamp for calculation epoch (defaults to current time if omitted)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Overhead satellite computed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverheadResponse"
                }
              }
            }
          },
          "404": {
            "description": "No satellite overhead found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pipelines/sync": {
      "post": {
        "tags": [
          "Pipelines"
        ],
        "summary": "Trigger CelesTrak Pipeline Sync",
        "description": "Triggers automated CelesTrak discovery pipeline synchronization for a specific satellite group.",
        "operationId": "triggerPipelineSync",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "description": "CelesTrak satellite group name (e.g. 'stations', 'visual', 'starlink', 'weather', 'active', 'last-30-days')",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pipeline sync completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineSyncResponse"
                }
              }
            }
          },
          "500": {
            "description": "Pipeline sync execution failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/satellites": {
      "get": {
        "tags": [
          "Satellites"
        ],
        "summary": "List Satellites",
        "description": "Retrieves a paginated list of satellites using base64 checkpoint cursors.",
        "operationId": "listSatellites",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of satellites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponseSatellite"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Satellites"
        ],
        "summary": "Create Satellite",
        "description": "Creates a new satellite record from Two-Line Element (TLE) set data.",
        "operationId": "createSatellite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSatelliteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Satellite created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Satellite"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/satellites/{id}": {
      "get": {
        "tags": [
          "Satellites"
        ],
        "summary": "Get Satellite by ID",
        "description": "Retrieves details for a specific satellite by its unique UUID.",
        "operationId": "getSatellite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Satellite found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Satellite"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Satellites"
        ],
        "summary": "Delete Satellite",
        "description": "Deletes a satellite record by its unique UUID.",
        "operationId": "deleteSatellite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Satellite deleted successfully"
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Satellites"
        ],
        "summary": "Update Satellite",
        "description": "Updates a satellite's name or TLE orbital parameters.",
        "operationId": "updateSatellite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSatelliteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Satellite updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Satellite"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/satellites/{id}/next-visible": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Get Next Visible Pass",
        "description": "Calculates the next visible pass for a specific satellite above elevation threshold.",
        "operationId": "getNextVisiblePass",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "description": "Observer latitude in decimal degrees (-90.0 to 90.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Observer longitude in decimal degrees (-180.0 to 180.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "alt",
            "in": "query",
            "description": "Observer altitude above sea level in meters",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          },
          {
            "name": "threshold_deg",
            "in": "query",
            "description": "Minimum elevation angle threshold in degrees (default: 5.0 deg)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next visible pass calculated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextVisiblePassResponse"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSatelliteDto": {
        "type": "object",
        "required": [
          "name",
          "lineOne",
          "lineTwo"
        ],
        "properties": {
          "lineOne": {
            "type": "string"
          },
          "lineTwo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "status"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "NextVisiblePassResponse": {
        "type": "object",
        "required": [
          "satelliteId",
          "satelliteName",
          "passTime",
          "elevationDeg",
          "azimuthDeg",
          "rangeKm"
        ],
        "properties": {
          "azimuthDeg": {
            "type": "number",
            "format": "double"
          },
          "elevationDeg": {
            "type": "number",
            "format": "double"
          },
          "passTime": {
            "type": "string",
            "format": "date-time"
          },
          "rangeKm": {
            "type": "number",
            "format": "double"
          },
          "satelliteId": {
            "type": "string",
            "format": "uuid"
          },
          "satelliteName": {
            "type": "string"
          }
        }
      },
      "OverheadResponse": {
        "type": "object",
        "required": [
          "satellite",
          "elevation"
        ],
        "properties": {
          "elevation": {
            "type": "number",
            "format": "double"
          },
          "satellite": {
            "$ref": "#/components/schemas/Satellite"
          }
        }
      },
      "PaginatedResponseSatellite": {
        "type": "object",
        "description": "Generic Paginated Response envelope",
        "required": [
          "data",
          "pagination"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Satellite"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "description": "Metadata envelope for paginated responses",
        "required": [
          "hasMore",
          "limit",
          "totalCount"
        ],
        "properties": {
          "hasMore": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PipelineSyncResponse": {
        "type": "object",
        "required": [
          "group",
          "syncedCount",
          "message"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "syncedCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Satellite": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tle",
          "createdDate",
          "lastModifiedDate"
        ],
        "properties": {
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lastModifiedDate": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "tle": {
            "$ref": "#/components/schemas/Tle"
          }
        }
      },
      "Tle": {
        "type": "object",
        "required": [
          "lineOne",
          "lineTwo"
        ],
        "properties": {
          "lineOne": {
            "type": "string"
          },
          "lineTwo": {
            "type": "string"
          }
        }
      },
      "UpdateSatelliteDto": {
        "type": "object",
        "properties": {
          "lineOne": {
            "type": "string",
            "nullable": true
          },
          "lineTwo": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Satellites",
      "description": "Satellite management endpoints"
    },
    {
      "name": "Astrodynamics",
      "description": "Orbital calculations and pass predictions"
    },
    {
      "name": "Pipelines",
      "description": "CelesTrak automated discovery pipelines"
    }
  ]
}