{
  "openapi": "3.0.3",
  "info": {
    "title": "astrea-sda-api",
    "description": "A high-performance Rust API for Space Domain Awareness (SDA), satellite tracking, SGP4 propagation, and visibility prediction",
    "contact": {
      "name": "Michael Wedd"
    },
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/astrodynamics/overhead": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Get Overhead Satellite",
        "description": "Computes the satellite closest to overhead (highest elevation) across all tracked satellites using parallel Rayon propagation.",
        "operationId": "getOverheadSatellite",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Observer latitude in decimal degrees (-90.0 to 90.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Observer longitude in decimal degrees (-180.0 to 180.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "alt",
            "in": "query",
            "description": "Observer altitude above sea level in meters",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          },
          {
            "name": "time",
            "in": "query",
            "description": "UTC timestamp for calculation epoch (defaults to current time if omitted)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Overhead satellite computed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverheadResponse"
                }
              }
            }
          },
          "404": {
            "description": "No satellite overhead found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "OpenAPI endpoint handler to issue an RS256 JWT authentication token for testing or client auth.",
        "operationId": "loginHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "RS256 JWT Token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conjunctions/search": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Search Conjunctions & Satellite Collision Radar",
        "description": "Evaluates close-approach orbital conjunctions across all active satellites using Rayon parallel execution.",
        "operationId": "searchConjunctions",
        "parameters": [
          {
            "name": "max_distance_km",
            "in": "query",
            "description": "Maximum threshold distance in km between satellites to trigger a conjunction match (default: 10.0 km)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          },
          {
            "name": "duration_hours",
            "in": "query",
            "description": "Forecast window forward in hours (default: 24 hrs, max: 72)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "step_minutes",
            "in": "query",
            "description": "Step interval in minutes (default: 1 min, max: 60)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conjunction radar search completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConjunctionSearchResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal calculation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pipelines/sync": {
      "post": {
        "tags": [
          "Pipelines"
        ],
        "summary": "Trigger CelesTrak Pipeline Sync",
        "description": "Triggers automated CelesTrak discovery pipeline synchronization for a specific satellite group. Protected by JWT auth (requires 'editor' or 'admin' role).",
        "operationId": "triggerPipelineSync",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "description": "CelesTrak satellite group name (e.g. 'stations', 'visual', 'starlink', 'weather', 'active', 'last-30-days')",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pipeline sync completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineSyncResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient role permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Pipeline sync execution failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/satellites": {
      "get": {
        "tags": [
          "Satellites"
        ],
        "summary": "List Satellites",
        "description": "Retrieves a paginated list of satellites using base64 checkpoint cursors.",
        "operationId": "listSatellites",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of satellites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponseSatellite"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Satellites"
        ],
        "summary": "Create Satellite",
        "description": "Creates a new satellite record from Two-Line Element (TLE) set data. Protected by JWT auth (requires 'editor' or 'admin' role).",
        "operationId": "createSatellite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSatelliteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Satellite created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Satellite"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient role permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/satellites/{id}": {
      "get": {
        "tags": [
          "Satellites"
        ],
        "summary": "Get Satellite by ID",
        "description": "Retrieves details for a specific satellite by its unique UUID.",
        "operationId": "getSatellite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Satellite found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Satellite"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Satellites"
        ],
        "summary": "Delete Satellite",
        "description": "Deletes a satellite record by its unique UUID. Protected by JWT auth (requires 'admin' role).",
        "operationId": "deleteSatellite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Satellite deleted successfully"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Admin role required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Satellites"
        ],
        "summary": "Update Satellite",
        "description": "Updates a satellite's name or TLE orbital parameters. Protected by JWT auth (requires 'editor' or 'admin' role).",
        "operationId": "updateSatellite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSatelliteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Satellite updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Satellite"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient role permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/satellites/{id}/groundtrack": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Get Satellite 3D Ground Track & Trajectory",
        "description": "Computes 3D ECF coordinates, geodetic position, orbital period, footprint radius, and GeoJSON ground track line.",
        "operationId": "getGroundTrack",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "duration_minutes",
            "in": "query",
            "description": "Trajectory projection duration in minutes (default: 90 mins, max: 1440)",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0
            }
          },
          {
            "name": "step_seconds",
            "in": "query",
            "description": "Step sampling interval in seconds (default: 30 secs, max: 300)",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Output format ('geojson' or 'json', default: 'geojson')",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "UTC timestamp to start projection from (defaults to current time if omitted)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "3D Ground Track and GeoJSON trajectory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroundTrackResponse"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal calculation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/satellites/{id}/illumination": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Get Satellite Illumination & Visual Magnitude",
        "description": "Computes solar shadow geometry (FullSunlight, Penumbra, Umbra), observer twilight state, observable status, and visual magnitude.",
        "operationId": "getSatelliteIllumination",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "description": "Observer latitude in decimal degrees (-90.0 to 90.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Observer longitude in decimal degrees (-180.0 to 180.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "alt",
            "in": "query",
            "description": "Observer altitude above sea level in meters (default: 0.0 m)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          },
          {
            "name": "time",
            "in": "query",
            "description": "UTC timestamp for calculation epoch (defaults to current time if omitted)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Satellite illumination status computed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IlluminationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/satellites/{id}/next-visible": {
      "get": {
        "tags": [
          "Astrodynamics"
        ],
        "summary": "Get Next Visible Pass",
        "description": "Calculates the next visible pass for a specific satellite above elevation threshold.",
        "operationId": "getNextVisiblePass",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Satellite unique UUID identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "description": "Observer latitude in decimal degrees (-90.0 to 90.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Observer longitude in decimal degrees (-180.0 to 180.0)",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "alt",
            "in": "query",
            "description": "Observer altitude above sea level in meters",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          },
          {
            "name": "threshold_deg",
            "in": "query",
            "description": "Minimum elevation angle threshold in degrees (default: 5.0 deg)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next visible pass calculated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextVisiblePassResponse"
                }
              }
            }
          },
          "404": {
            "description": "Satellite not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "description": "Response returned upon successful RS256 JWT token generation.",
        "required": [
          "token",
          "tokenType",
          "expiresIn",
          "claims"
        ],
        "properties": {
          "claims": {
            "$ref": "#/components/schemas/Claims"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Token lifetime in seconds (e.g. 86400)",
            "minimum": 0
          },
          "token": {
            "type": "string",
            "description": "Encoded RS256 JWT Bearer token"
          },
          "tokenType": {
            "type": "string",
            "description": "Token type (always \"Bearer\")"
          }
        }
      },
      "Claims": {
        "type": "object",
        "description": "JWT Claims payload structure containing standard OIDC and OAuth 2.0 claim fields.",
        "required": [
          "sub",
          "exp",
          "iat",
          "role"
        ],
        "properties": {
          "aud": {
            "type": "string",
            "description": "Token audience (target API audience)",
            "nullable": true
          },
          "exp": {
            "type": "integer",
            "description": "Expiration timestamp in seconds since Unix epoch",
            "minimum": 0
          },
          "iat": {
            "type": "integer",
            "description": "Issued-at timestamp in seconds since Unix epoch",
            "minimum": 0
          },
          "iss": {
            "type": "string",
            "description": "Token issuer (OIDC issuer URI or auth server ID)",
            "nullable": true
          },
          "role": {
            "type": "string",
            "description": "User role (\"viewer\", \"editor\", or \"admin\")"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of secondary roles",
            "nullable": true
          },
          "scope": {
            "type": "string",
            "description": "Space-separated OAuth 2.0 scopes string (e.g. \"read:satellites write:satellites admin:satellites\")",
            "nullable": true
          },
          "sub": {
            "type": "string",
            "description": "Subject (User ID, username, or client service ID)"
          }
        }
      },
      "ConjunctionMatch": {
        "type": "object",
        "required": [
          "satelliteA",
          "satelliteB",
          "closestApproachTime",
          "minDistanceKm",
          "relativeVelocityKms"
        ],
        "properties": {
          "closestApproachTime": {
            "type": "string",
            "format": "date-time"
          },
          "minDistanceKm": {
            "type": "number",
            "format": "double"
          },
          "relativeVelocityKms": {
            "type": "number",
            "format": "double"
          },
          "satelliteA": {
            "$ref": "#/components/schemas/SatelliteSummary"
          },
          "satelliteB": {
            "$ref": "#/components/schemas/SatelliteSummary"
          }
        }
      },
      "ConjunctionSearchResponse": {
        "type": "object",
        "required": [
          "searchDurationHours",
          "maxDistanceKm",
          "conjunctionsFound",
          "results"
        ],
        "properties": {
          "conjunctionsFound": {
            "type": "integer",
            "minimum": 0
          },
          "maxDistanceKm": {
            "type": "number",
            "format": "double"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConjunctionMatch"
            }
          },
          "searchDurationHours": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateSatelliteDto": {
        "type": "object",
        "required": [
          "name",
          "lineOne",
          "lineTwo"
        ],
        "properties": {
          "lineOne": {
            "type": "string"
          },
          "lineTwo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "status"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "GeoJsonFeature": {
